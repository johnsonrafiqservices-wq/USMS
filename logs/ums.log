            {% if affected_students_data %}
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Student ID</th>
                      <th>Name</th>
                      <th>Programme</th>
                      <th>Level</th>
                      <th>Fee Amount</th>
                      <th>Amount Paid</th>
                      <th>Balance</th>
                      <th>Payment Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for student_data in affected_students_data %}
                    {% with student=student_data.student %}
                    <tr class="student-row">
                      <td><span class="fw-bold text-primary">{{ student.student_id }}</span></td>
                      <td>{{ student.user.get_full_name }}</td>
                      <td>{{ student.programme.name }}</td>
                      <td>Year {{ student.current_year.name }}</td>
                      <td class="text-end">UGX {{ student_data.fee_amount|floatformat:0 }}</td>
                      <td class="text-end">
                        {% if student_data.amount_paid > 0 %}
                          <span class="text-success">UGX {{ student_data.amount_paid|floatformat:0 }}</span>
                        {% else %}
                          <span class="text-muted">UGX 0</span>
                        {% endif %}
                      </td>
                      <td class="text-end">
                        {% if student_data.balance > 0 %}
                          <span class="text-danger">UGX {{ student_data.balance|floatformat:0 }}</span>
                        {% else %}
                          <span class="text-success">UGX 0</span>
                        {% endif %}
                      </td>
                      <td>
                        {% if student_data.payment_status == 'Paid' %}
                          <span class="badge bg-success">Paid</span>
                        {% elif student_data.payment_status == 'Partially Paid' %}
                          <span class="badge bg-info">Partially Paid</span>
                        {% elif student_data.payment_status == 'Pending' %}
                          <span class="badge bg-warning">Pending</span>
                        {% else %}
                          <span class="badge bg-secondary">Not Invoiced</span>
                        {% endif %}
                      </td>
                    </tr>
                    {% endwith %}
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              {% if total_students > 50 %}
              <div class="text-center mt-3 text-muted">
                <small>Showing first 50 of {{ total_students }} students</small>
              </div>
              {% endif %}
            {% else %}
              <div class="text-center py-4 text-muted">
                <i class="bi bi-people fs-1"></i>
                <p class="mt-2">No students found matching this fee criteria.</p>
              </div>
            {% endif %}
        
